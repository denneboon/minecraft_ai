venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# IDE / OS clutter
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.ipynb_checkpoints/
.python-version

# ---------------------------------------------------------------------------
# Claude Code local-only settings (the shared settings.json IS tracked)
# ---------------------------------------------------------------------------
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------------
# data/ — keep the directory skeleton (.gitkeep), ignore generated content.
#
# Layout (all directories created in code or extracted by tools):
#   data/mc_assets/    — extracted Minecraft jar assets, ignored entirely
#   data/raw/          — raw captured frames, ignored
#   data/replays/      — recorded episodes, ignored
#   data/training/     — labelled datasets, ignored
#   data/logs/         — agent runtime logs, ignored
#   data/calibration/  — calibration outputs and run snapshots, mostly ignored
# ---------------------------------------------------------------------------
data/mc_assets/

data/raw/*
!data/raw/.gitkeep

data/replays/*
!data/replays/.gitkeep

data/training/*
!data/training/.gitkeep

data/logs/*
!data/logs/.gitkeep

data/manifests/*
!data/manifests/.gitkeep

data/meta/*
!data/meta/.gitkeep

# calibration/ holds tons of run-time PNG/JSON/SCHEM/TXT artefacts.
# We ignore EVERYTHING here by default; tracked-by-intent files can be
# whitelisted below if needed.
data/calibration/*
!data/calibration/.gitkeep

# Inventory-sample dataset (auto-collected from hovers) — same pattern.
data/samples/*
!data/samples/.gitkeep

# Self-teaching metrics (per-session history JSONL/CSV + generated PNG
# charts) and debug screenshots — local runtime artefacts.
data/metrics/*
!data/metrics/.gitkeep
data/debug/*
!data/debug/.gitkeep

# ---------------------------------------------------------------------------
# Model weights / large binaries — Git LFS or out-of-tree only
# ---------------------------------------------------------------------------
models/*.pt
models/*.pth
models/*.onnx
models/*.safetensors
models/*.bin
models/*.ckpt
models/*.npz

# ---------------------------------------------------------------------------
# Experiment outputs (checkpoints, tensorboard runs, wandb caches)
# ---------------------------------------------------------------------------
experiments/**/checkpoints/
experiments/**/runs/
experiments/**/wandb/
experiments/**/outputs/
